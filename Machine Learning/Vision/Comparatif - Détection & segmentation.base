filters:
  and:
    # `Dev/Services/` devient faux au lot 3 ; `role` dit ce que le chemin disait :
    # un comparatif compare des briques, pas les notions qui portent le meme tag.
    - role == "brique"
    - or:
        - file.hasTag("object-detection")
        - file.hasTag("segmentation")
views:
  - type: table
    name: Détection & segmentation
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
