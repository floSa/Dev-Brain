filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "ml/orchestration"
views:
  - type: table
    name: Orchestrateurs ML
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - hosted
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Kubernetes-natif
    filters:
      and:
        - tags.contains("kubernetes")
    order:
      - file.name
      - pitch
      - langage
      - hosted
    sort:
      - property: file.name
        direction: asc
