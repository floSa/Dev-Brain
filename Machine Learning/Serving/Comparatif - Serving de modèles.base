filters:
  and:
    - categorie == "ml/serving"
views:
  - type: table
    name: Serving de modèles
    order:
      - file.name
      - pitch
      - licence_type
      - hosted
      - scaling
      - langage
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Open-source maintenu
    filters:
      and:
        - licence_type == "open-source"
        - maturite != "deprecated"
    order:
      - file.name
      - pitch
      - hosted
      - scaling
    sort:
      - property: file.name
        direction: asc
