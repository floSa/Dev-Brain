filters:
  and:
    # Un comparatif compare des briques, pas les notions du dossier.
    - role == "brique"
    # Les offres tombent dans quatre catégories, par l'arbre D1->D14 : le service
    # de maintenance (ml/maintenance), la plateforme de données d'atelier
    # (data/industrie), l'outil d'analyse (data/bi) et l'historien
    # (database/series-temporelles). Le tag `predictive-maintenance` les réunit.
    - or:
        - categorie == "ml/maintenance"
        - categorie == "data/industrie"
        - categorie == "data/bi"
        - categorie == "database/series-temporelles"
    - file.hasTag("predictive-maintenance")
    # L'annuaire des jeux de données PHM porte le même tag : ce n'est pas une offre.
    - famille != "annuaire"
views:
  - type: table
    name: Offres de maintenance prédictive
    order:
      - file.name
      - pitch
      - famille
      - licence_type
      - hosted
      - maturite
      - categorie
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Auto-hébergeables
    filters:
      and:
        - hosted.contains("self")
    order:
      - file.name
      - pitch
      - licence_type
      - maturite
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Ouvertes aux nouveaux projets
    filters:
      and:
        - maturite != "deprecated"
    order:
      - file.name
      - pitch
      - hosted
      - licence_type
    sort:
      - property: file.name
        direction: asc
