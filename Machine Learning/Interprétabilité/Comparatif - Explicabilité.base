filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    # `ml/interpretabilite` existe desormais comme domaine : le detour par le tag
    # `explainability` (C3) n'a plus d'objet. Memes 7 membres.
    - categorie == "ml/interpretabilite"
views:
  - type: table
    name: Explicabilité des modèles
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
