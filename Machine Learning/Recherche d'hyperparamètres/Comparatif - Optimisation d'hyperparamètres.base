filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "ml/hyperopt"
views:
  - type: table
    name: Optimisation d'hyperparamètres
    order:
      - file.name
      - pitch
      - licence_type
      - hosted
      - scaling
      - langage
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Open-source maintenu
    filters:
      and:
        - licence_type == "open-source"
        - maturite != "deprecated"
    order:
      - file.name
      - pitch
      - hosted
      - scaling
    sort:
      - property: file.name
        direction: asc
