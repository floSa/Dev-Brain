filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    # les 3 sous-domaines `automation/*` ont fusionne en `automation/no-code` :
    # le filtre par prefixe n'a plus d'objet.
    - categorie == "automation/no-code"
views:
  - type: table
    name: Automatisation no-code
    order:
      - file.name
      - pitch
      - categorie
      - langage
      - licence_type
      - hosted
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Self-hostable
    filters:
      and:
        - hosted.contains("self")
    order:
      - file.name
      - pitch
      - licence_type
      - langage
    sort:
      - property: file.name
        direction: asc
