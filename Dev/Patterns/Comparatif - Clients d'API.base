filters:
  and:
    - file.path.startsWith("Dev/Outils/")
    # `tooling/api` a eclate : les clients d'API d'un cote, l'annuaire
    # `public-apis` (`web/api`, famille annuaire) de l'autre — un annuaire n'est
    # pas un client, il sort du comparatif.
    - categorie == "devtools/client-api"
views:
  - type: table
    name: Clients d'API
    order:
      - file.name
      - pitch
      - os
      - licence_type
      - langage
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Open-source
    filters:
      and:
        - licence_type == "open-source"
    order:
      - file.name
      - pitch
      - os
      - langage
    sort:
      - property: file.name
        direction: asc
