filters:
  and:
    - file.path.startsWith("Dev/Services/")
    # `tooling/stats` a eclate en 4 sous-domaines `stats/*` (inference, bayesien,
    # exploratoire, causal). Le comparatif porte sur le prefixe entier : c'est son
    # perimetre historique, et il gagne `lifelines` (analyse de survie), qui etait
    # range en `ml/framework`.
    - categorie.startsWith("stats/")
views:
  - type: table
    name: Outils stats
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Maintenus en production
    filters:
      and:
        - maturite == "production"
    order:
      - file.name
      - pitch
      - licence_type
      - alternatives
    sort:
      - property: file.name
        direction: asc
