filters:
  and:
    - file.path.startsWith("Dev/Services/")
    # `ui/ml-demo` a fusionne dans `ui/data-app` (Gradio) : une seule valeur suffit.
    - categorie == "ui/data-app"
views:
  - type: table
    name: Apps & démos
    order:
      - file.name
      - pitch
      - categorie
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Démos ML
    filters:
      and:
        - file.hasTag("ml-demo")
    order:
      - file.name
      - pitch
      - langage
      - alternatives
    sort:
      - property: file.name
        direction: asc
