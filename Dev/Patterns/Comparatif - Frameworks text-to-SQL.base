filters:
  and:
    - file.path.startsWith("Dev/Services/")
    # `llm/text-to-sql` existe desormais comme domaine, et absorbe les deux
    # ex-`llm/framework-module` : le detour par le tag n'a plus d'objet.
    # Memes 5 membres.
    - categorie == "llm/text-to-sql"
views:
  - type: table
    name: Text-to-SQL (frameworks + modules)
    order:
      - file.name
      - pitch
      - categorie
      - licence_type
      - hosted
      - scaling
      - langage
      - maturite
      - status
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Activement maintenus (OSS)
    filters:
      and:
        - status == "actif"
    order:
      - file.name
      - pitch
      - licence_type
      - hosted
    sort:
      - property: file.name
        direction: asc
