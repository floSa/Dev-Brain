filters:
  and:
    - file.path.startsWith("Dev/Services/")
    # `compute/distributed` a eclate : le distribue multi-noeuds et le calcul GPU.
    # Les deux sont reunis ici, c'est le perimetre historique du comparatif.
    - or:
        - categorie == "compute/distribue"
        - categorie == "compute/gpu"
views:
  - type: table
    name: Calcul distribué
    order:
      - file.name
      - pitch
      - licence_type
      - hosted
      - scaling
      - langage
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Open-source maintenu
    filters:
      and:
        - licence_type == "open-source"
        - maturite != "deprecated"
    order:
      - file.name
      - pitch
      - hosted
      - scaling
    sort:
      - property: file.name
        direction: asc
