filters:
  and:
    - categorie == "database/recherche"
views:
  - type: table
    name: Moteurs de recherche
    order:
      - file.name
      - pitch
      - hosted
      - scaling
      - langage
      - licence_type
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Maintenus (hors déprécié)
    filters:
      and:
        - maturite != "deprecated"
    order:
      - file.name
      - pitch
      - langage
      - scaling
    sort:
      - property: file.name
        direction: asc
