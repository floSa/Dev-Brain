filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "database/migration"
views:
  - type: table
    name: Outils de migration
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Open-source / open-core
    filters:
      and:
        - licence_type != "proprietary"
    order:
      - file.name
      - pitch
      - hosted
      - langage
    sort:
      - property: file.name
        direction: asc
