filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "database/analytique"
views:
  - type: table
    name: Bases colonnes / OLAP
    order:
      - file.name
      - pitch
      - hosted
      - scaling
      - langage
      - licence_type
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Embarqué
    filters:
      and:
        - scaling == "single-node"
    order:
      - file.name
      - pitch
      - langage
      - licence_type
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Distribué
    filters:
      and:
        - scaling == "distributed"
    order:
      - file.name
      - pitch
      - langage
      - licence_type
    sort:
      - property: file.name
        direction: asc
