filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "data/orchestration"
views:
  - type: table
    name: Orchestrateurs data
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - hosted
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Distribués
    filters:
      and:
        - scaling == "distributed"
    order:
      - file.name
      - pitch
      - langage
      - alternatives
    sort:
      - property: file.name
        direction: asc
