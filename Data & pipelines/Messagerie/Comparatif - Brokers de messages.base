filters:
  and:
    # Un comparatif compare des briques : la clause de role garde les notions
    # rangees sous la meme categorie hors de la vue.
    - role == "brique"
    - categorie == "data/messagerie"
views:
  - type: table
    name: Brokers de messages
    filters:
      and:
        - tags.contains("message-broker")
    order:
      - file.name
      - pitch
      - licence_type
      - langage
      - maturite
      - hosted
      - scaling
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: File de tâches (consommateur de brokers)
    filters:
      and:
        - tags.contains("task-queue")
    order:
      - file.name
      - pitch
      - licence_type
      - langage
      - maturite
      - complements
    sort:
      - property: file.name
        direction: asc
