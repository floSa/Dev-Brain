filters:
  and:
    # `tooling/data` a eclate en 4 domaines. Ce comparatif garde les DataFrames et
    # tableaux N-dimensionnels. En sortent : `data/synthetique` (Faker, Mimesis),
    # `signal/traitement` (PyWavelets, scipy.signal), `data/ingestion` (connectorx).
    - categorie == "data/tableau"
views:
  - type: table
    name: Manipulation de données
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: DataFrames
    filters:
      and:
        - file.hasTag("dataframe")
    order:
      - file.name
      - pitch
      - langage
      - scaling
      - alternatives
    sort:
      - property: file.name
        direction: asc
