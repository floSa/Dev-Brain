filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "data/scraping"
views:
  - type: table
    name: Scraping
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Parsing HTML
    filters:
      and:
        - file.hasTag("document-parsing")
    order:
      - file.name
      - pitch
      - langage
      - scaling
      - alternatives
    sort:
      - property: file.name
        direction: asc
