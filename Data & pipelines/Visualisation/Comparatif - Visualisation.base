filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    # `tooling/viz` a eclate : les bibliotheques de trace (`data/viz`) et les
    # profileurs EDA (`data/eda`, couverts par « Comparatif - Outils EDA - profiling »).
    - categorie == "data/viz"
views:
  - type: table
    name: Visualisation
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Interactif
    filters:
      and:
        - file.hasTag("interactive-viz")
    order:
      - file.name
      - pitch
      - langage
      - alternatives
    sort:
      - property: file.name
        direction: asc
