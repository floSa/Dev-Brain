filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    # `data/eda` existe desormais comme domaine (les profileurs quittent
    # `tooling/viz`). Memes 3 membres.
    - categorie == "data/eda"
views:
  - type: table
    name: Outils EDA / profiling
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
