filters:
  and:
    # `data/eda` existe desormais comme domaine (les profileurs quittent
    # `tooling/viz`). Memes 3 membres.
    - categorie == "data/eda"
views:
  - type: table
    name: Outils EDA / profiling
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
      - tags
      - alternatives
    sort:
      - property: file.name
        direction: asc
