filters:
  and:
    # `devtools/paquet` existe desormais comme domaine. Memes 2 membres.
    - categorie == "devtools/paquet"
views:
  - type: table
    name: Gestionnaires de paquets Python
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
    sort:
      - property: file.name
        direction: asc
