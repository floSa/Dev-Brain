filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    # `devtools/paquet` existe desormais comme domaine. Memes 2 membres.
    - categorie == "devtools/paquet"
views:
  - type: table
    name: Gestionnaires de paquets Python
    order:
      - file.name
      - pitch
      - langage
      - licence_type
      - maturite
      - scaling
    sort:
      - property: file.name
        direction: asc
