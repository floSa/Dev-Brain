filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "design/diagramme"
views:
  - type: table
    name: Outils de diagramme
    order:
      - file.name
      - pitch
      - licence_type
      - os
      - langage
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Diagram-as-code
    filters:
      and:
        - tags.contains("diagram-as-code")
    order:
      - file.name
      - pitch
      - licence_type
    sort:
      - property: file.name
        direction: asc
