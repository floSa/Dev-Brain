filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "llm/runtime"
views:
  - type: table
    name: Exécution & serving LLM
    order:
      - file.name
      - pitch
      - licence_type
      - hosted
      - scaling
      - langage
      - maturite
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Runtimes locaux (single-node)
    filters:
      and:
        - scaling == "single-node"
    order:
      - file.name
      - pitch
      - langage
      - hosted
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Serveurs haut débit (distribué)
    filters:
      and:
        - scaling == "distributed"
    order:
      - file.name
      - pitch
      - langage
      - hosted
    sort:
      - property: file.name
        direction: asc
