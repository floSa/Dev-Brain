filters:
  and:
    # Un comparatif compare des briques. Clause ajoutée au lot 4 : depuis que
    # les notions se rangent sur la même `categorie:` que les briques, un filtre
    # de catégorie seul absorbe les notions du sous-domaine.
    - role == "brique"
    - categorie == "llm/agent-de-code"
views:
  - type: table
    name: Assistants de code IA
    order:
      - file.name
      - pitch
      - os
      - licence_type
      - langage
      - tags
    sort:
      - property: file.name
        direction: asc
  - type: table
    name: Mode agent
    filters:
      and:
        - tags.contains("agents")
    order:
      - file.name
      - pitch
      - langage
    sort:
      - property: file.name
        direction: asc
